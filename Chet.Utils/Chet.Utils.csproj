<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
    <ImplicitUsings Condition="'$(TargetFramework)' == 'net8.0'">enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Title>Chet.Utils — A comprehensive C# utility library | C# 综合工具类库</Title>
    <Authors>Chet</Authors>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/qiect/Chet.Utils</RepositoryUrl>
    <PackageProjectUrl>https://qiect.github.io/Chet.Utils</PackageProjectUrl>
    <PackageIcon>logo.png</PackageIcon>
		<Description>A comprehensive C# utility library that simplifies daily .NET development with rich extension methods and helper classes. Extensions: Bool, String, Int, Float, Double, Decimal, Enum, DataTable, DateTime, File, Stream, Enumerable, and more. Helpers: HttpClientHelper, FileHelper, WebSocketHelper, RegexHelper, TaskHelper, UnitHelper, StopwatchHelper, ReflectHelper, ApplicationHelper, DataTableHelper, and more. Targets .NET Standard 2.1 and .NET 8.0+. C# 综合工具类库，提供丰富的扩展方法与帮助类，简化日常 .NET 开发。</Description>
		<Version>1.6.0</Version>
		<Product />
	</PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <DefineConstants>NETSTANDARD2_1</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <DefineConstants>NET8_0</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\logo.png" Pack="true" PackagePath="\" />
  </ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
		<PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
		<PackageReference Include="System.Text.Json" Version="8.0.5" />
		<PackageReference Include="System.Threading.Channels" Version="8.0.0" />
		<PackageReference Include="System.Net.Http" Version="4.3.4" />
		<PackageReference Include="System.Security.Principal.Windows" Version="5.0.0" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.10" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
	</ItemGroup>

</Project>